#!/bin/zsh
# agent-rotate [--brief] [--dry-run]: start a fresh session. Clears the saved
# session id (kept as session-id.prev) and SIGTERMs only agent-loop's claude
# child; the loop starts a new session ~10s later with the same flags.
# --brief also queues [morning-brief] for the new session.
# Detaches and waits 5s first, so the agent can call it on itself after
# writing handoff.md.
emulate -L zsh
kit=${0:A:h:h}; source "$kit/lib/env.zsh"
log="$AGENT_LOGS/rotate.log"
dry=0; now=0; brief=0
for a in "$@"; do
  case $a in
    --dry-run) dry=1 ;;
    --now) now=1 ;;     # internal: skip the detach
    --brief) brief=1 ;;
    -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
    *) print -u2 "agent-rotate: unknown arg $a"; exit 2 ;;
  esac
done
say() { print -r -- "$(date '+%F %T') ${${dry:#0}:+[dry-run] }$*" | tee -a "$log"; }

# claude processes whose parent is an agent-loop.
targets() {
  local loop
  for loop in $(/usr/bin/pgrep -f 'bin/agent-loop( |$)'); do
    /usr/bin/pgrep -P "$loop" -f 'claude( |$)'
  done
}

if (( ! now && ! dry )); then
  say "detaching; rotating in 5s"
  nohup "$0" --now ${${brief:#0}:+--brief} >/dev/null 2>&1 </dev/null &!
  exit 0
fi
(( now )) && sleep 5

pids=($(targets))
old="$(cat "$AGENT_STATE/session-id" 2>/dev/null)"
if (( ${#pids} == 0 )); then
  say "no agent-loop claude child found; session-id left as ${old:-<none>}"
  exit 1
fi
if (( dry )); then
  say "would move session-id ${old:-<none>} to session-id.prev and SIGTERM ${pids[*]}"
  exit 0
fi
[[ -n $old ]] && print -r -- "$old" > "$AGENT_STATE/session-id.prev"
rm -f "$AGENT_STATE/session-id"
kill -TERM $pids && say "sent SIGTERM to ${pids[*]}; loop starts a new session in ~10s"
# Queue after the kill so the old session can't pick it up.
(( brief )) && sleep 1 && "$kit/bin/agent-tick" morning-brief | tee -a "$log"
